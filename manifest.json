{
  "manifest_version": 3,
  "name": "FakeSale",
  "version": "1.2.0",
  "description": "Logs the price of every product page you visit and tells you which \"sales\" are real and which are fake.",
  "homepage_url": "https://github.com/jonpikereally/FakeSale",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "FakeSale",
    "default_popup": "app/app.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms", "activeTab"]
}
